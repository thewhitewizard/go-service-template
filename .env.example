# Copy to .env for local runs. .env is gitignored; this file is not.
#
# Every variable below is read once at startup and validated: an invalid value
# stops the launch instead of degrading the service at request time. A blank or
# whitespace-only value is treated as unset and falls back to the default.
#
# Never put a real secret in this file — it is committed. Document the variable
# here with a placeholder, and add the field to Config.LogValue as "[REDACTED]"
# so it can never be printed by a log line added later.

# HTTP listen address.
SERVICE_LISTEN_ADDR=:8080

# Log level: debug | info | warn | error
SERVICE_LOG_LEVEL=info

# Durations accept a Go duration ("30s", "2m") or a plain integer of seconds.

# Bounds reading the incoming request.
SERVICE_READ_TIMEOUT=15s

# Bounds idle keep-alive connections.
SERVICE_IDLE_TIMEOUT=120s

# Bounds writing the response. Set to 0 (unlimited) if this service ever streams
# a long response, otherwise the stream is cut mid-flight.
SERVICE_WRITE_TIMEOUT=30s

# Bounds graceful shutdown. Keep it below the orchestrator's termination grace
# period, or the process is killed before it finishes draining.
SERVICE_SHUTDOWN_TIMEOUT=20s

# --- Local stack only (docker compose), not read by the service ---------------
# Host ports. Override when one is already taken on your machine; the container
# ports and the Prometheus scrape config are fixed and need no change.
SERVICE_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
