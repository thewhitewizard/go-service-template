{
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git push origin --delete:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-pr-size.sh\"",
            "timeout": 20,
            "statusMessage": "Checking PR size (≤ 400 lines of Go, tests included)…"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-commit.sh\"",
            "timeout": 10,
            "statusMessage": "Checking branch and commit message…"
          }
        ]
      }
    ]
  }
}
